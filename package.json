{
  "name": "service-plane",
  "version": "0.2.0",
  "description": "Ability-first Service Plane primitives for schema-backed Cap'n Web RPC, STS capability tokens, OpenAPI, and MCP projections.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JUVOJustin/service-plane.git"
  },
  "bugs": {
    "url": "https://github.com/JUVOJustin/service-plane/issues"
  },
  "homepage": "https://github.com/JUVOJustin/service-plane#readme",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./service": {
      "types": "./dist/service/index.d.ts",
      "import": "./dist/service/index.js"
    },
    "./control-plane": {
      "types": "./dist/control-plane/index.d.ts",
      "import": "./dist/control-plane/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "sync:skill-docs": "cp docs/*.md .apm/skills/service-plane/references/",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "capnweb",
    "cap-n-web",
    "hono",
    "microservices",
    "rpc",
    "object-capability",
    "control-plane",
    "service-discovery",
    "sts",
    "capabilities",
    "abilities",
    "zod",
    "cloudflare-workers"
  ],
  "peerDependencies": {
    "hono": ">=4.10.3 <5.0.0",
    "zod": ">=4.0.0 <5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "hono": "^4.12.31",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@hono/capnweb": "^0.1.0",
    "capnweb": "^0.10.0"
  }
}
