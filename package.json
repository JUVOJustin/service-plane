{
  "name": "service-plane",
  "version": "0.4.0",
  "description": "Ability-first Service Plane primitives for schema-backed oRPC, capability tokens, OpenAPI, and MCP projections.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JUVOJustin/service-plane.git"
  },
  "bugs": {
    "url": "https://github.com/JUVOJustin/service-plane/issues"
  },
  "homepage": "https://github.com/JUVOJustin/service-plane#readme",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./service": {
      "types": "./dist/service/index.d.ts",
      "import": "./dist/service/index.js"
    },
    "./control-plane": {
      "types": "./dist/control-plane/index.d.ts",
      "import": "./dist/control-plane/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.json",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "sync:skill-docs": "cp docs/*.md .apm/skills/service-plane/references/",
    "bench": "vitest bench --run",
    "test": "vitest run",
    "test:workerd": "vitest run --config vitest.workerd.config.ts",
    "smoke:build": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "prepare": "npm run build",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "orpc",
    "hono",
    "microservices",
    "rpc",
    "capability-security",
    "control-plane",
    "service-discovery",
    "sts",
    "capabilities",
    "abilities",
    "standard-schema",
    "cloudflare-workers"
  ],
  "peerDependencies": {
    "hono": ">=4.13.0 <5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "hono": "^4.13.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@orpc/client": "2.0.0-beta.29",
    "@orpc/contract": "2.0.0-beta.29",
    "@orpc/hibernation": "2.0.0-beta.29",
    "@orpc/server": "2.0.0-beta.29",
    "@standard-schema/spec": "^1.1.0"
  }
}
