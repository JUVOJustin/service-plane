{
  "name": "service-plane",
  "version": "0.4.0-beta.1",
  "description": "Ability-first Service Plane primitives for typed RPC, capability tokens, OpenAPI, and MCP projections.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JUVOJustin/service-plane.git"
  },
  "bugs": {
    "url": "https://github.com/JUVOJustin/service-plane/issues"
  },
  "homepage": "https://github.com/JUVOJustin/service-plane#readme",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./service": {
      "types": "./dist/service/index.d.ts",
      "import": "./dist/service/index.js"
    },
    "./control-plane": {
      "types": "./dist/control-plane/index.d.ts",
      "import": "./dist/control-plane/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.json",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "sync:skill-docs": "node scripts/sync-skill-docs.mjs",
    "bench": "vitest bench --run",
    "test": "vitest run",
    "test:workerd": "vitest run --config vitest.workerd.config.ts",
    "smoke:build": "node scripts/smoke.mjs",
    "smoke:types": "node scripts/type-consumer-smoke.mjs",
    "smoke": "npm run smoke:build && npm run smoke:types && node smoke-dist/cli.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "verify": "npm run check && npm run typecheck && npm run test && npm run test:workerd && npm run build && npm run smoke",
    "prepare": "npm run build",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "hono",
    "microservices",
    "rpc",
    "capability-security",
    "control-plane",
    "service-discovery",
    "sts",
    "capabilities",
    "abilities",
    "standard-schema",
    "cloudflare-workers"
  ],
  "peerDependencies": {
    "hono": ">=4.13.7 <5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "hono": "^4.13.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@orpc/client": "2.0.0-beta.33",
    "@orpc/hibernation": "2.0.0-beta.33",
    "@orpc/server": "2.0.0-beta.33",
    "@standard-schema/spec": "^1.1.0"
  }
}
